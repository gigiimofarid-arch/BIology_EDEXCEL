<script>
const answers = {
  q1:'B', q2:'C', q3:'C', q4:'B', q5:'B', q6:'B',
  q10:'C', q13:'C', q14:'B', q16:'B',
  q19:'C', q20:'C', q21:'B', q24:'C', q25:'C', q28:'D', q30:'B', q33:'B', q36:'C',
  q37:'D', q40:'B', q43:'C', q47:'B', q49:'B', q52:'C',
  q55:'B', q58:'C', q63:'C', q69:'B',
  q71:'B', q75:'C', q82:'B'
};

let scores = { correct: 0, wrong: 0 };

function mcq(el, qid, choice) {
  const parent = document.getElementById(qid);
  if (parent.classList.contains('answered')) return;
  const correct = answers[qid];
  const opts = parent.querySelectorAll('.option');
  opts.forEach(o => {
    const letter = o.querySelector('.option-letter').textContent;
    if (letter === correct) o.classList.add('correct');
  });
  const fb = document.getElementById('fb-' + qid);
  if (choice === correct) {
    el.classList.add('correct');
    fb.textContent = '✓ Correct!';
    fb.className = 'feedback correct-fb show';
    parent.classList.add('answered');
    scores.correct++;
  } else {
    el.classList.add('wrong');
    fb.textContent = '✗ Incorrect. The correct answer is ' + correct + '.';
    fb.className = 'feedback wrong-fb show';
    parent.classList.add('answered');
    parent.classList.add('wrong');
    scores.wrong++;
  }
  updateScore();
}

function updateScore() {
  const total = scores.correct + scores.wrong;
  document.getElementById('score-display').textContent = scores.correct + ' / ' + total + ' MCQ';
  document.getElementById('r-correct').textContent = scores.correct;
  document.getElementById('r-wrong').textContent = scores.wrong;
  document.getElementById('r-total').textContent = total;
  document.getElementById('r-pct').textContent = total > 0 ? Math.round(scores.correct / total * 100) + '%' : '0%';
  document.getElementById('results').classList.add('show');
}

function showModelAnswer(btn, text) {
  btn.textContent = 'Hide answer';
  btn.onclick = function() {
    const existing = btn.previousElementSibling;
    if (existing && existing.classList.contains('model-ans')) {
      existing.remove();
      btn.textContent = 'Show model answer';
      btn.onclick = function() { showModelAnswer(btn, text); };
      return;
    }
  };
  const div = document.createElement('div');
  div.className = 'feedback correct-fb show model-ans';
  div.style.whiteSpace = 'pre-line';
  div.innerHTML = '<strong style="font-size:12px;display:block;margin-bottom:4px;">Model answer:</strong>' + text;
  btn.parentNode.insertBefore(div, btn);
}

function showSection(id) {
  document.querySelectorAll('.section-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const idx = ['s1','s2','s3','s4','s5'].indexOf(id);
  document.querySelectorAll('.nav-btn')[idx].classList.add('active');
  window.scrollTo({top: 0, behavior: 'smooth'});
}
</script>
